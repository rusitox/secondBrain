# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/digital_twin
DATABASE_URL_SYNC=postgresql+psycopg2://user:password@localhost:5432/digital_twin
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_key

# AI Models
OPENAI_API_KEY=your_openai_key
# LLM provider API key (for whichever provider LLM_MODEL uses)
LLM_API_KEY=your_llm_api_key
# Model string — format: provider/model-name. Examples:
#   anthropic/claude-haiku-4-5-20251001  (default, cheapest Anthropic)
#   openai/gpt-4o-mini                   (cheapest quality OpenAI)
#   gemini/gemini-2.0-flash              (cheapest Google)
LLM_MODEL=anthropic/claude-haiku-4-5-20251001

# Security — generate with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
FERNET_KEY=your_fernet_key_here

# App Settings
APP_ENV=development
DEBUG=True
