# secondBrain Production Environment
# Copy to /opt/secondbrain/.env.prod and fill in values
#
# Usage:
#   docker compose -f docker-compose.prod.yml --env-file /opt/secondbrain/.env.prod up -d

# App
APP_ENV=production

# Database — used by both db and api containers
DB_PASSWORD=<generate-strong-password>
# DATABASE_URL and DATABASE_URL_SYNC are constructed in docker-compose.prod.yml

# Security — generate with:
#   python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
FERNET_KEY=<your-fernet-key>

# Embeddings (OpenAI)
OPENAI_API_KEY=<your-openai-key>

# LLM — provider API key (for whichever provider LLM_MODEL uses)
LLM_API_KEY=<your-llm-api-key>
# Model string — format: provider/model-name. Examples:
#   anthropic/claude-haiku-4-5-20251001  (~$0.80/1M input, cheapest Anthropic)
#   openai/gpt-4o-mini                   (~$0.15/1M input, cheapest quality OpenAI)
#   gemini/gemini-2.0-flash              (~$0.10/1M input, cheapest Google)
LLM_MODEL=anthropic/claude-haiku-4-5-20251001

# Docker image tag (optional, defaults to "latest")
# IMAGE_TAG=latest
