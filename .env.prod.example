# secondBrain Production Environment
# Copy to /opt/secondbrain/.env.prod and fill in values
#
# Usage:
#   docker compose -f docker-compose.prod.yml --env-file /opt/secondbrain/.env.prod up -d

# App
APP_ENV=production

# Database — used by both db and api containers
DB_PASSWORD=<generate-strong-password>
# DATABASE_URL and DATABASE_URL_SYNC are constructed in docker-compose.prod.yml

# Security — generate with:
#   python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
FERNET_KEY=<your-fernet-key>

# AI Models
OPENAI_API_KEY=<your-openai-key>
CLAUDE_API_KEY=<your-anthropic-key>

# Docker image tag (optional, defaults to "latest")
# IMAGE_TAG=latest
