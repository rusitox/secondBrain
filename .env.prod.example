# secondBrain Production Environment
# Copy to .env.prod and fill in values

APP_ENV=production

# Database (password used by both db and api containers)
DB_PASSWORD=<generate-strong-password>

# These are constructed from DB_PASSWORD in docker-compose.prod.yml
# DATABASE_URL and DATABASE_URL_SYNC are set in docker-compose.prod.yml

# Security — generate with:
#   python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
FERNET_KEY=<your-fernet-key>

# AI Models
OPENAI_API_KEY=<your-openai-key>
CLAUDE_API_KEY=<your-anthropic-key>
